# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (cascade router — src/services/llm.py) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# Model rẻ cho classify/reason/routing (tiết kiệm cost)
MODEL_CLASSIFY=gpt-4o-mini
# Model mạnh cho sinh câu trả lời cuối
MODEL_GENERATE=gpt-4o
# Judge PHẢI khác MODEL_GENERATE (chống self-preference bias — app sẽ raise nếu trùng)
MODEL_JUDGE=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048

# ---- Agent loop ----
# Số vòng ReAct tối đa trước khi escape hatch -> finalize_with_partial
AGENT_MAX_ITERATIONS=8
# Or use other providers (set LLM_PROVIDER accordingly):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=google
# GOOGLE_API_KEY=
# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
